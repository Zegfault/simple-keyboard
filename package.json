{
  "name": "vue-simple-keyboard",
  "version": "1.0.0",
  "description": "A Vue 3 component wrapper for simple-keyboard virtual keyboard library",
  "main": "dist/vue-simple-keyboard-index.umd.js",
  "module": "dist/vue-simple-keyboard-index.es.js",
  "files": [
    "dist",
    "dist/vue-simple-keyboard.css",
    "src"
  ],
  "exports": {
    ".": {
      "import": "./dist/vue-simple-keyboard-index.es.js",
      "require": "./dist/vue-simple-keyboard-index.umd.js"
    },
    "./style.css": "./dist/vue-simple-keyboard.css"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite serve examples --config examples/vite.config.js",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.vue --ignore-pattern .gitignore --fix src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zegfault/simple-keyboard.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "keyboard",
    "virtual-keyboard",
    "simple-keyboard",
    "component",
    "onscreen",
    "osk"
  ],
  "author": "hugo.barbier@imagination.com",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Zegfault/simple-keyboard/issues"
  },
  "homepage": "https://github.com/Zegfault/simple-keyboard#readme",
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "dependencies": {
    "@rollup/plugin-strip": "^3.0.4",
    "auto-bind": "^5.0.1",
    "lodash": "^4.17.21",
    "sass": "^1.77.8",
    "simple-keyboard": "^3.8.83",
    "simple-keyboard-layouts": "^3.4.130"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^9.22.0",
    "eslint-plugin-vue": "^9.27.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "terser": "^5.44.0",
    "vite": "^7.1.6",
    "vue": "^3.5.21"
  }
}

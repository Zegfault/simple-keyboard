{
  "name": "vue-simple-keyboard-component",
  "version": "1.0.0",
  "description": "A Vue 3 component wrapper for simple-keyboard virtual keyboard library",
  "main": "dist/vue-simple-keyboard.umd.js",
  "module": "dist/vue-simple-keyboard.es.js",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "import": "./dist/vue-simple-keyboard.es.js",
      "require": "./dist/vue-simple-keyboard.umd.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite serve examples --config examples/vite.config.js",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zegfault/simple-keyboard.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "keyboard",
    "virtual-keyboard",
    "simple-keyboard",
    "component",
    "onscreen",
    "osk"
  ],
  "author": "hugo.barbier@imagination.com",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Zegfault/simple-keyboard/issues"
  },
  "homepage": "https://github.com/Zegfault/simple-keyboard#readme",
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "simple-keyboard": "^3.8.83",
    "simple-keyboard-layouts": "^3.4.130"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vue": "^3.5.21"
  }
}
